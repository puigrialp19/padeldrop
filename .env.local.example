# =====================================================================
#  PADEL DROP · Variables de entorno
#  1) Copia este archivo y llámalo .env.local   (está en .gitignore: NUNCA se sube a GitHub)
#  2) Rellena los valores. En producción (Etapa 4) estas mismas variables se ponen en el hosting.
# =====================================================================

# --- General ---------------------------------------------------------
# development en tu ordenador | production en el hosting
NODE_ENV=development
PORT=3000
# Dirección exacta de la web, sin barra final. En producción: https://padeldrop.eu
PUBLIC_URL=http://localhost:3000

# --- Base de datos -----------------------------------------------------
# Etapa 1 (local): deja "pglite" -> base de datos PostgreSQL local en la carpeta data/, sin instalar nada.
# Etapa 2 (Supabase): pega aquí la cadena de conexión "Session pooler" de Supabase, por ejemplo:
#   postgresql://postgres.abcdefghijklmnop:TU-CONTRASEÑA@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=pglite

# --- Panel de administración --------------------------------------------
# Horas sin actividad antes de cerrar la sesión del panel
SESSION_HOURS=8
# Solo en el hosting (Etapa 4): 1 = la web está detrás del proxy del hosting
TRUST_PROXY=

# --- Stripe (Etapa 3) -----------------------------------------------------
# Clave RESTRINGIDA de Stripe (rk_test_... en pruebas, rk_live_... en real) con solo 2 permisos de lectura:
# Customers = Read y Subscriptions = Read. Si alguien la robara, no podría cobrar ni devolver dinero.
STRIPE_SECRET_KEY=
# Dashboard de Stripe -> Desarrolladores -> Webhooks -> tu endpoint -> "Secreto de firma" (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Price ID del gasto de envío mensual (3,50 €). Modo pruebas: price_1UTSGRRq7KJQz9G9pcum76B0
STRIPE_SHIPPING_PRICE_ID=price_1UTSGRRq7KJQz9G9pcum76B0
