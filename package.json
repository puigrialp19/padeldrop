{
  "name": "padel-drop",
  "version": "2.1.0",
  "private": true,
  "description": "PADEL DROP: web de suscripción mensual de pelotas y grips de pádel + panel de administración privado.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i tailwind/admin.css -o admin/css/admin.css --minify",
    "watch:css": "tailwindcss -i tailwind/admin.css -o admin/css/admin.css --watch",
    "db:init": "node server/scripts/init-db.js",
    "db:seed": "node server/scripts/seed.js",
    "db:clear-demo": "node server/scripts/seed.js --clear",
    "create-admin": "node server/scripts/create-admin.js",
    "test:webhook": "node server/scripts/test-webhook.js",
    "stripe:setup": "node server/scripts/stripe-setup.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "postgres": "^3.4.9",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-socket": "^0.2.14",
    "@tailwindcss/cli": "^4.1.4",
    "tailwindcss": "^4.1.4"
  },
  "license": "UNLICENSED"
}
